{
  "name": "PaymentPlan",
  "type": "object",
  "description": "Installment payment plan (Splitit-style) attached to a CollectionsCase \u2014 splits a debt into scheduled installments, tracked through authorization, activation, completion or cancellation.",
  "properties": {
    "collections_case_id": {
      "type": "string",
      "description": "Reference to the CollectionsCase this plan repays"
    },
    "debtor_name": {
      "type": "string"
    },
    "total_amount": {
      "type": "number",
      "description": "Total amount to be repaid across all installments (\u20aa)"
    },
    "number_of_installments": {
      "type": "number"
    },
    "installment_amount": {
      "type": "number",
      "description": "Base installment amount (\u20aa) \u2014 last installment absorbs any rounding remainder"
    },
    "frequency": {
      "type": "string",
      "enum": [
        "weekly",
        "biweekly",
        "monthly"
      ],
      "default": "monthly"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending_authorization",
        "active",
        "completed",
        "cancelled",
        "failed"
      ],
      "default": "pending_authorization",
      "description": "Overall plan lifecycle state"
    },
    "authorization_status": {
      "type": "string",
      "enum": [
        "pending",
        "authorized",
        "declined"
      ],
      "default": "pending",
      "description": "Result of the payment authorization step (card/mandate check) before the schedule goes live"
    },
    "idempotency_key": {
      "type": "string",
      "description": "Stable key derived from case+amount+installments \u2014 prevents duplicate plan creation for the same case"
    },
    "cancelled_at": {
      "type": "string",
      "format": "date-time"
    },
    "cancellation_reason": {
      "type": "string"
    }
  },
  "required": [
    "collections_case_id",
    "total_amount",
    "number_of_installments"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}