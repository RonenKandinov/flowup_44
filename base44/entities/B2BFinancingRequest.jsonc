{
  "name": "B2BFinancingRequest",
  "type": "object",
  "description": "Unified B2B financing request \u2014 covers Reverse Factoring, RBF, Purchase Order Financing, SME Working Capital, and Merchant Cash Advance. Drives the underwriting flow for non-check B2B products.",
  "properties": {
    "business_id": {
      "type": "string",
      "description": "Internal user id of the requesting business / underwriting target"
    },
    "business_name": {
      "type": "string"
    },
    "business_tax_id": {
      "type": "string",
      "description": "\u05d7.\u05e4 \u05e9\u05dc \u05d4\u05e2\u05e1\u05e7 \u05d4\u05e0\u05d1\u05d7\u05df"
    },
    "product_type": {
      "type": "string",
      "enum": [
        "reverse_factoring",
        "revenue_based_financing",
        "purchase_order_financing",
        "working_capital",
        "merchant_cash_advance"
      ],
      "description": "Type of B2B financing product"
    },
    "requested_amount": {
      "type": "number",
      "description": "Amount requested (\u20aa)"
    },
    "term_months": {
      "type": "number"
    },
    "context": {
      "type": "object",
      "description": "Product-specific context: counterparty tax id (reverse factoring), MRR target (RBF), PO number & buyer (PO financing), acquirer name (MCA), etc."
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "processing",
        "approved",
        "review",
        "adjusted",
        "rejected"
      ],
      "default": "pending"
    },
    "decision": {
      "type": "object",
      "description": "Structured decision output (tier, rate, max amount, repayment %, justification)"
    },
    "analysis_id": {
      "type": "string",
      "description": "Reference to UnderwritingAnalysis record"
    }
  },
  "required": [
    "business_id",
    "product_type",
    "requested_amount"
  ]
}