{
  "name": "CollectionsCase",
  "type": "object",
  "description": "Collections case \u2014 driven by Collections Intelligence. Each case wraps an overdue invoice with a recommended strategy, contact history, and AI-driven risk segmentation.",
  "properties": {
    "invoice_id": {
      "type": "string",
      "description": "Reference to the Invoice entity record"
    },
    "debtor_name": {
      "type": "string"
    },
    "amount_due": {
      "type": "number"
    },
    "days_overdue": {
      "type": "number"
    },
    "risk_segment": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "description": "AI-driven risk classification"
    },
    "recommended_strategy": {
      "type": "string",
      "enum": [
        "soft_reminder",
        "firm_reminder",
        "phone_call",
        "payment_plan",
        "legal_action",
        "write_off"
      ],
      "description": "Suggested next action by Collections AI"
    },
    "last_contact_at": {
      "type": "string",
      "format": "date-time"
    },
    "next_action_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "in_progress",
        "promised_to_pay",
        "resolved",
        "escalated",
        "closed"
      ],
      "default": "open"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "debtor_name",
    "amount_due"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}