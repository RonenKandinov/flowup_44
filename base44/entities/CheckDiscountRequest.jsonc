{
  "name": "CheckDiscountRequest",
  "type": "object",
  "description": "Check discounting request \u2014 B2B product. Stores check details extracted via OCR or manual entry, plus the underwriting analysis result.",
  "properties": {
    "requesting_business_id": {
      "type": "string",
      "description": "User ID of the requesting SME"
    },
    "check_image_url": {
      "type": "string",
      "description": "Uploaded check image URL"
    },
    "third_party_tax_id": {
      "type": "string",
      "description": "\u05d7.\u05e4 / \u05ea.\u05d6 \u05e9\u05dc \u05db\u05d5\u05ea\u05d1 \u05d4\u05e6'\u05e7 (\u05e6\u05d3 \u05d2')"
    },
    "third_party_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05db\u05d5\u05ea\u05d1 \u05d4\u05e6'\u05e7"
    },
    "amount": {
      "type": "number",
      "description": "\u05e1\u05db\u05d5\u05dd \u05d4\u05e6'\u05e7"
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05e4\u05d9\u05e8\u05e2\u05d5\u05df"
    },
    "check_number": {
      "type": "string"
    },
    "bank_branch": {
      "type": "string"
    },
    "ocr_confidence": {
      "type": "number",
      "description": "OCR confidence score 0-1"
    },
    "ocr_raw_text": {
      "type": "string"
    },
    "third_party_history": {
      "type": "object",
      "description": "Behavioral intelligence summary on the third party (bounces, prior deposits, amounts)"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "processing",
        "approved",
        "review",
        "adjusted",
        "rejected"
      ],
      "default": "pending"
    },
    "decision_reason": {
      "type": "string"
    },
    "discount_rate": {
      "type": "number",
      "description": "\u05d0\u05d7\u05d5\u05d6 \u05d4\u05e2\u05de\u05dc\u05d4 / \u05e0\u05d9\u05db\u05d9\u05d5\u05df \u05e9\u05e0\u05e7\u05d1\u05e2"
    },
    "analysis_id": {
      "type": "string",
      "description": "Reference to UnderwritingAnalysis"
    }
  },
  "required": [
    "requesting_business_id",
    "amount",
    "due_date"
  ]
}