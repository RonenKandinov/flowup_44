{
  "name": "UnderwritingRule",
  "type": "object",
  "properties": {
    "company_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d7\u05d1\u05e8\u05ea \u05d4\u05de\u05d9\u05de\u05d5\u05df"
    },
    "max_dti_approve": {
      "type": "number",
      "description": "DTI \u05de\u05e7\u05e1\u05d9\u05de\u05dc\u05d9 \u05dc\u05d0\u05d9\u05e9\u05d5\u05e8 \u05d0\u05d5\u05d8\u05d5\u05de\u05d8\u05d9 (%)",
      "default": 35
    },
    "max_dti_review": {
      "type": "number",
      "description": "DTI \u05de\u05e7\u05e1\u05d9\u05de\u05dc\u05d9 \u05dc\u05d1\u05d7\u05d9\u05e0\u05d4 (\u05de\u05e2\u05dc \u05d6\u05d4 - \u05d3\u05d7\u05d9\u05d9\u05d4) (%)",
      "default": 45
    },
    "min_liquidity_months": {
      "type": "number",
      "description": "\u05de\u05d9\u05e0\u05d9\u05de\u05d5\u05dd \u05d7\u05d5\u05d3\u05e9\u05d9 \u05e0\u05d6\u05d9\u05dc\u05d5\u05ea \u05e0\u05d3\u05e8\u05e9\u05d9\u05dd",
      "default": 1
    },
    "max_expense_income_ratio": {
      "type": "number",
      "description": "\u05d9\u05d7\u05e1 \u05d4\u05d5\u05e6\u05d0\u05d5\u05ea/\u05d4\u05db\u05e0\u05e1\u05d5\u05ea \u05de\u05e7\u05e1\u05d9\u05de\u05dc\u05d9 (%)",
      "default": 90
    },
    "min_income": {
      "type": "number",
      "description": "\u05d4\u05db\u05e0\u05e1\u05d4 \u05d7\u05d5\u05d3\u05e9\u05d9\u05ea \u05de\u05d9\u05e0\u05d9\u05de\u05dc\u05d9\u05ea (\u20aa)",
      "default": 8000
    },
    "enable_second_chance": {
      "type": "boolean",
      "description": "\u05d4\u05e4\u05e2\u05dc \u05de\u05e0\u05d2\u05e0\u05d5\u05df \u05d4\u05d6\u05d3\u05de\u05e0\u05d5\u05ea \u05e9\u05e0\u05d9\u05d9\u05d4 (Second Chance)",
      "default": true
    },
    "min_discretionary_cut_pct": {
      "type": "number",
      "description": "\u05d0\u05d7\u05d5\u05d6 \u05de\u05d9\u05e0\u05d9\u05de\u05dc\u05d9 \u05dc\u05d7\u05d9\u05ea\u05d5\u05da \u05d4\u05d5\u05e6\u05d0\u05d5\u05ea \u05d3\u05d9\u05e1\u05e7\u05e8\u05e6\u05d9\u05d5\u05e0\u05d9\u05d5\u05ea (Guardrail \u05ea\u05d7\u05ea\u05d5\u05df \u05e2\u05dc \u03b2)",
      "default": 20
    },
    "max_discretionary_cut_pct": {
      "type": "number",
      "description": "\u05d0\u05d7\u05d5\u05d6 \u05de\u05e7\u05e1\u05d9\u05de\u05dc\u05d9 \u05dc\u05d7\u05d9\u05ea\u05d5\u05da \u05d4\u05d5\u05e6\u05d0\u05d5\u05ea \u05d3\u05d9\u05e1\u05e7\u05e8\u05e6\u05d9\u05d5\u05e0\u05d9\u05d5\u05ea (Guardrail \u05e2\u05dc\u05d9\u05d5\u05df \u05e2\u05dc \u03b2 - \u05de\u05d5\u05e0\u05e2 \u05d0\u05d5\u05e4\u05d8\u05d9\u05de\u05d9\u05d6\u05dd \u05d9\u05ea\u05e8)",
      "default": 70
    },
    "min_liquidity_runway_months": {
      "type": "number",
      "description": "\u05d7\u05d5\u05d3\u05e9\u05d9 \u05d4\u05d9\u05e9\u05e8\u05d3\u05d5\u05ea \u05de\u05d9\u05e0\u05d9\u05de\u05dc\u05d9\u05d9\u05dd (Liquidity Runway) - \u05d0\u05dd \u05e4\u05d7\u05d5\u05ea, \u05d4\u05ea\u05d9\u05e7 \u05e2\u05d5\u05d1\u05e8 \u05dc-Conditional/Rejected",
      "default": 3
    },
    "pricing_trust_discount_k1": {
      "type": "number",
      "description": "\u05de\u05e7\u05d3\u05dd \u05d4\u05e0\u05d7\u05d4 \u05d1\u05e8\u05d9\u05d1\u05d9\u05ea \u05e2\u05d1\u05d5\u05e8 \u05d0\u05de\u05d5\u05df \u05ea\u05d6\u05e8\u05d9\u05de\u05d9 (k1) - \u05d4\u05e8\u05d9\u05d1\u05d9\u05ea \u05d9\u05d5\u05e8\u05d3\u05ea \u05d1-k1 \u00d7 trustScore",
      "default": 0.02
    },
    "pricing_risk_premium_k2": {
      "type": "number",
      "description": "\u05de\u05e7\u05d3\u05dd \u05e4\u05e8\u05de\u05d9\u05d9\u05ea \u05e1\u05d9\u05db\u05d5\u05df \u05dc\u05db\u05dc \u05d3\u05d2\u05dc \u05d0\u05d3\u05d5\u05dd (k2) - \u05d4\u05e8\u05d9\u05d1\u05d9\u05ea \u05e2\u05d5\u05dc\u05d4 \u05d1-k2 \u00d7 #riskFlags",
      "default": 0.005
    },
    "pricing_tier_a_max_dsr": {
      "type": "number",
      "description": "DSR \u05de\u05e7\u05e1\u05d9\u05de\u05dc\u05d9 \u05dc-Tier A (Prime) - \u05d0\u05d9\u05e9\u05d5\u05e8 \u05d6\u05d5\u05dc",
      "default": 45
    },
    "pricing_tier_a_min_rate": {
      "type": "number",
      "description": "\u05e8\u05d9\u05d1\u05d9\u05ea \u05de\u05d9\u05e0\u05d9\u05de\u05dc\u05d9\u05ea \u05dc-Tier A (%)",
      "default": 7
    },
    "pricing_tier_a_max_rate": {
      "type": "number",
      "description": "\u05e8\u05d9\u05d1\u05d9\u05ea \u05de\u05e7\u05e1\u05d9\u05de\u05dc\u05d9\u05ea \u05dc-Tier A (%)",
      "default": 9
    },
    "pricing_tier_b_max_dsr": {
      "type": "number",
      "description": "DSR \u05de\u05e7\u05e1\u05d9\u05de\u05dc\u05d9 \u05dc-Tier B (Near Prime) - \u05d0\u05d9\u05e9\u05d5\u05e8 \u05e8\u05d2\u05d9\u05dc",
      "default": 55
    },
    "pricing_tier_b_min_rate": {
      "type": "number",
      "description": "\u05e8\u05d9\u05d1\u05d9\u05ea \u05de\u05d9\u05e0\u05d9\u05de\u05dc\u05d9\u05ea \u05dc-Tier B (%)",
      "default": 9
    },
    "pricing_tier_b_max_rate": {
      "type": "number",
      "description": "\u05e8\u05d9\u05d1\u05d9\u05ea \u05de\u05e7\u05e1\u05d9\u05de\u05dc\u05d9\u05ea \u05dc-Tier B (%)",
      "default": 12
    },
    "pricing_tier_c_max_dsr": {
      "type": "number",
      "description": "DSR \u05de\u05e7\u05e1\u05d9\u05de\u05dc\u05d9 \u05dc-Tier C (Subprime) - \u05d0\u05d9\u05e9\u05d5\u05e8 \u05d9\u05e7\u05e8/\u05de\u05d5\u05ea\u05e0\u05d4 (Stretch)",
      "default": 65
    },
    "pricing_tier_c_min_rate": {
      "type": "number",
      "description": "\u05e8\u05d9\u05d1\u05d9\u05ea \u05de\u05d9\u05e0\u05d9\u05de\u05dc\u05d9\u05ea \u05dc-Tier C (%)",
      "default": 12
    },
    "pricing_tier_c_max_rate": {
      "type": "number",
      "description": "\u05e8\u05d9\u05d1\u05d9\u05ea \u05de\u05e7\u05e1\u05d9\u05de\u05dc\u05d9\u05ea \u05dc-Tier C (%)",
      "default": 16
    },
    "enable_stretch_offer": {
      "type": "boolean",
      "description": "\u05d0\u05e4\u05e9\u05e8 \u05d4\u05e6\u05e2\u05ea Stretch (Tier C) - \u05e1\u05db\u05d5\u05dd \u05d2\u05d1\u05d5\u05d4 \u05d9\u05d5\u05ea\u05e8, DSR \u05d2\u05d1\u05d5\u05d4 \u05d9\u05d5\u05ea\u05e8, \u05e8\u05d9\u05d1\u05d9\u05ea \u05d2\u05d1\u05d5\u05d4\u05d4 \u05d9\u05d5\u05ea\u05e8",
      "default": true
    },
    "stretch_min_trust_score": {
      "type": "number",
      "description": "\u05e6\u05d9\u05d5\u05df \u05d0\u05de\u05d5\u05df \u05ea\u05d6\u05e8\u05d9\u05de\u05d9 \u05de\u05d9\u05e0\u05d9\u05de\u05dc\u05d9 \u05dc\u05d6\u05db\u05d0\u05d5\u05ea \u05dc-Stretch Offer (0-1)",
      "default": 0.4
    },
    "stretch_min_runway_months": {
      "type": "number",
      "description": "\u05d7\u05d5\u05d3\u05e9\u05d9 \u05d4\u05d9\u05e9\u05e8\u05d3\u05d5\u05ea \u05de\u05d9\u05e0\u05d9\u05de\u05dc\u05d9\u05d9\u05dd \u05dc\u05d6\u05db\u05d0\u05d5\u05ea \u05dc-Stretch Offer",
      "default": 2
    },
    "stretch_max_risk_flags": {
      "type": "number",
      "description": "\u05de\u05e1\u05e4\u05e8 \u05de\u05e7\u05e1\u05d9\u05de\u05dc\u05d9 \u05e9\u05dc \u05d3\u05d2\u05dc\u05d9 \u05e1\u05d9\u05db\u05d5\u05df \u05d4\u05de\u05d0\u05e4\u05e9\u05e8\u05d9\u05dd Stretch Offer",
      "default": 2
    },
    "pd_base": {
      "type": "number",
      "description": "Probability of Default \u05d1\u05e1\u05d9\u05e1\u05d9 (PD0) - \u05d4\u05e1\u05ea\u05d1\u05e8\u05d5\u05ea \u05db\u05e9\u05dc \u05d1\u05e1\u05d9\u05e1\u05d9\u05ea \u05d2\u05dd \u05dc\u05dc\u05e7\u05d5\u05d7 Prime",
      "default": 0.02
    },
    "pd_dsr_coefficient": {
      "type": "number",
      "description": "\u05de\u05e7\u05d3\u05dd \u05d4\u05e9\u05e4\u05e2\u05ea DSR \u05e2\u05dc PD - \u05de\u05e2\u05dc\u05d4 \u05d0\u05ea \u05d4-PD \u05d1-(coeff \u00d7 DSR)",
      "default": 0.5
    },
    "pd_trust_coefficient": {
      "type": "number",
      "description": "\u05de\u05e7\u05d3\u05dd \u05d4\u05e9\u05e4\u05e2\u05ea \u05d7\u05d5\u05e1\u05e8 \u05d0\u05de\u05d5\u05df \u05e2\u05dc PD - \u05de\u05e2\u05dc\u05d4 \u05d0\u05ea \u05d4-PD \u05d1-(coeff \u00d7 (1 - trust))",
      "default": 0.3
    },
    "pd_flags_coefficient": {
      "type": "number",
      "description": "\u05de\u05e7\u05d3\u05dd \u05d4\u05e9\u05e4\u05e2\u05ea \u05d3\u05d2\u05dc\u05d9 \u05e1\u05d9\u05db\u05d5\u05df \u05e2\u05dc PD - \u05dc\u05db\u05dc \u05d3\u05d2\u05dc \u05de\u05d5\u05e1\u05d9\u05e3 (coeff) \u05dc-PD",
      "default": 0.05
    },
    "pd_runway_coefficient": {
      "type": "number",
      "description": "\u05de\u05e7\u05d3\u05dd \u05d4\u05e9\u05e4\u05e2\u05ea \u05d7\u05d5\u05e1\u05e8 \u05e0\u05d6\u05d9\u05dc\u05d5\u05ea \u05e2\u05dc PD - \u05de\u05e2\u05dc\u05d4 \u05d0\u05ea \u05d4-PD \u05db\u05e9-runway \u05e7\u05e6\u05e8",
      "default": 0.04
    },
    "pd_volatility_coefficient": {
      "type": "number",
      "description": "\u05de\u05e7\u05d3\u05dd \u05d4\u05e9\u05e4\u05e2\u05ea \u05ea\u05e0\u05d5\u05d3\u05ea\u05d9\u05d5\u05ea \u05d4\u05db\u05e0\u05e1\u05d4 \u05e2\u05dc PD - \u05de\u05d5\u05e1\u05d9\u05e3 (coeff) \u05dc-PD \u05db\u05e9\u05d4\u05ea\u05e0\u05d5\u05d3\u05ea\u05d9\u05d5\u05ea \u05d2\u05d1\u05d5\u05d4\u05d4",
      "default": 0.04
    },
    "lgd": {
      "type": "number",
      "description": "Loss Given Default - \u05d0\u05d7\u05d5\u05d6 \u05d4\u05d4\u05e4\u05e1\u05d3 \u05d4\u05e6\u05e4\u05d5\u05d9 \u05d1\u05de\u05e7\u05e8\u05d4 \u05db\u05e9\u05dc (0-1). \u05ea\u05e7\u05df: 0.6 = 60% \u05d4\u05e4\u05e1\u05d3",
      "default": 0.6
    },
    "min_expected_profit_margin": {
      "type": "number",
      "description": "\u05de\u05e8\u05d5\u05d5\u05d7 \u05e8\u05d5\u05d5\u05d7 \u05e6\u05e4\u05d5\u05d9 \u05de\u05d9\u05e0\u05d9\u05de\u05dc\u05d9 \u05dc\u05d0\u05d9\u05e9\u05d5\u05e8 (\u05db\u05d0\u05d7\u05d5\u05d6 \u05de\u05d4\u05e7\u05e8\u05df). 0.02 = 2% \u05de\u05d9\u05e0\u05d9\u05de\u05d5\u05dd",
      "default": 0.02
    },
    "enable_aggressive_approval": {
      "type": "boolean",
      "description": "\u05d0\u05e4\u05e9\u05e8 \u05d0\u05e1\u05d8\u05e8\u05d8\u05d2\u05d9\u05d9\u05ea aggressive_approval - \u05d4\u05e6\u05e2\u05d4 \u05e8\u05d5\u05d5\u05d7\u05d9\u05ea \u05d2\u05dd \u05d1\u05e1\u05d9\u05db\u05d5\u05df \u05d2\u05d1\u05d5\u05d4 (DSR \u05e2\u05d3 70%, \u05e8\u05d9\u05d1\u05d9\u05ea \u05e2\u05d3 18%)",
      "default": true
    },
    "aggressive_max_dsr": {
      "type": "number",
      "description": "DSR \u05de\u05e7\u05e1\u05d9\u05de\u05dc\u05d9 \u05dc-aggressive_approval (%)",
      "default": 70
    },
    "aggressive_min_rate": {
      "type": "number",
      "description": "\u05e8\u05d9\u05d1\u05d9\u05ea \u05de\u05d9\u05e0\u05d9\u05de\u05dc\u05d9\u05ea \u05dc-aggressive_approval (%)",
      "default": 14
    },
    "aggressive_max_rate": {
      "type": "number",
      "description": "\u05e8\u05d9\u05d1\u05d9\u05ea \u05de\u05e7\u05e1\u05d9\u05de\u05dc\u05d9\u05ea \u05dc-aggressive_approval (%)",
      "default": 18
    }
  },
  "required": [
    "company_name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}