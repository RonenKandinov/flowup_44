{
  "name": "OpenFinanceAccount",
  "type": "object",
  "properties": {
    "account_id": {
      "type": "string",
      "description": "External Account ID"
    },
    "connection_id": {
      "type": "string"
    },
    "currency": {
      "type": "string",
      "default": "ILS"
    },
    "balance": {
      "type": "number"
    },
    "balance_type": {
      "type": "string",
      "enum": [
        "interimAvailable",
        "closingBooked"
      ]
    },
    "name": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "description": "CHECKING, SAVINGS, CREDIT_CARD"
    }
  },
  "required": [
    "account_id",
    "connection_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}