{
  "name": "Installment",
  "type": "object",
  "description": "A single scheduled charge within a PaymentPlan. Tracks its own authorization/charge attempts so retries and duplicate-charge prevention happen per-installment.",
  "properties": {
    "payment_plan_id": {
      "type": "string",
      "description": "Reference to the parent PaymentPlan"
    },
    "installment_number": {
      "type": "number"
    },
    "amount": {
      "type": "number"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "paid",
        "failed",
        "retrying",
        "cancelled"
      ],
      "default": "pending"
    },
    "attempt_count": {
      "type": "number",
      "default": 0
    },
    "max_attempts": {
      "type": "number",
      "default": 3
    },
    "last_attempt_at": {
      "type": "string",
      "format": "date-time"
    },
    "paid_at": {
      "type": "string",
      "format": "date-time"
    },
    "failure_reason": {
      "type": "string"
    },
    "transaction_id": {
      "type": "string",
      "description": "Idempotent charge reference \u2014 set once payment succeeds, prevents re-charging a paid installment"
    }
  },
  "required": [
    "payment_plan_id",
    "installment_number",
    "amount",
    "due_date"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}