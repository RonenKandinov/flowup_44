{
  "name": "OpenFinanceTransaction",
  "type": "object",
  "properties": {
    "transaction_id": {
      "type": "string",
      "description": "External Transaction ID"
    },
    "account_id": {
      "type": "string"
    },
    "connection_id": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "currency": {
      "type": "string",
      "default": "ILS"
    },
    "date": {
      "type": "string",
      "format": "date-time",
      "description": "Booking Date"
    },
    "description": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "booked",
        "pending"
      ]
    }
  },
  "required": [
    "transaction_id",
    "account_id",
    "amount",
    "date"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": null
  }
}